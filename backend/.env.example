# Get a free Gemini API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use. Check https://aistudio.google.com/ for the current free-tier model name
# — Gemini's free-tier model names change over time; verify in AI Studio before relying on this default.
GEMINI_MODEL=gemini-2.0-flash

# Comma-separated list of origins allowed to call this API (your frontend URL)
# Example in production: https://resume-customizer.vercel.app
CORS_ORIGINS=http://localhost:3000

# Max resume upload size in MB
MAX_UPLOAD_MB=5
